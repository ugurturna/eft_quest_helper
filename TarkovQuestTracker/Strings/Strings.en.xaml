    <sys:String x:Key="s.keys.barToggle">show/hide</sys:String>
    <sys:String x:Key="s.keys.barWheel">overlay size</sys:String>
    <sys:String x:Key="s.keys.barTip">Overlay shortcuts - explained at the top of the Settings tab</sys:String>
    <sys:String x:Key="s.keys.flea">Flea market price search: opens in the middle of the screen; type 3 letters of an item name to see its prices for the selected mode (PvP / PvE) from tarkov.dev. Esc closes it and returns to the game.</sys:String>
