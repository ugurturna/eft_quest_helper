<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
      <ProjectReference Include="..\TarkovQuestTracker.Core\TarkovQuestTracker.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
      <PackageReference Include="SharpVectors.Wpf" Version="1.8.6" />
    </ItemGroup>

    <ItemGroup>
      <!-- compact the heap more eagerly (0-9); keeps the long-running process small -->
      <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    </ItemGroup>

    <ItemGroup>
      <!-- trader portraits; a missing one falls back to the trader's initial -->
      <Resource Include="Assets\Traders\*.png" />
      <!-- The Ticket ending achievement pictures -->
      <Resource Include="Assets\Endings\*.png" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\data\tasks_*.json;..\data\meta.json;..\data\quest_items.json;..\data\ticket_endings.json;..\data\extracts.json;..\data\maps.json;..\data\btr.json;..\data\story_choices.json" Link="data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
      <Content Include="..\data\icons\*.png" Link="data\icons\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    </ItemGroup>


    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <!-- 10.0.19041: Windows' built-in OCR (Windows.Media.Ocr) for reading the in-game Tasks screen -->
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <Version>0.11.0</Version>
        <!-- built with tools\make_icon.ps1 -->
        <ApplicationIcon Condition="Exists('Assets\app.ico')">Assets\app.ico</ApplicationIcon>
        <!-- runs next to the game all session: prefer a small footprint over GC throughput -->
        <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
        <AssemblyVersion>0.11.0</AssemblyVersion>
        <FileVersion>0.11.0</FileVersion>
        <Title>TarkovQuestTracker</Title>
        <Authors>UgurTurna</Authors>
        <Description>This app is just Helper. NO CHEAT!. Play Safe. have a good hunt</Description>
    </PropertyGroup>

</Project>
