<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
      <ProjectReference Include="..\TarkovQuestTracker.Core\TarkovQuestTracker.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    </ItemGroup>

    <ItemGroup>
      <!-- trader portraits; a missing one falls back to the trader's initial -->
      <Resource Include="Assets\Traders\*.png" />
      <!-- The Ticket ending achievement pictures -->
      <Resource Include="Assets\Endings\*.png" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\data\tasks_*.json;..\data\meta.json;..\data\quest_items.json;..\data\ticket_endings.json" Link="data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
      <Content Include="..\data\icons\*.png" Link="data\icons\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    </ItemGroup>


    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <Version>0.2.0</Version>
        <!-- built with tools\make_icon.ps1 -->
        <ApplicationIcon Condition="Exists('Assets\app.ico')">Assets\app.ico</ApplicationIcon>
        <AssemblyVersion>0.2.0</AssemblyVersion>
        <FileVersion>0.2.0</FileVersion>
    </PropertyGroup>

</Project>
