<Window x:Class="TarkovQuestTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TarkovQuestTracker.ViewModels"
        xmlns:local="clr-namespace:TarkovQuestTracker"
        xmlns:core="clr-namespace:TarkovQuestTracker.Core.Models;assembly=TarkovQuestTracker.Core"
        Title="Tarkov Quest Tracker" Height="820" Width="1280" MinWidth="900" MinHeight="560"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- clickable quest line used in prerequisite / unlock lists -->
        <DataTemplate x:Key="LinkRow" DataType="{x:Type vm:QuestRow}">
            <Button Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding Quest}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Background="Transparent" BorderThickness="0" Padding="4,2" Margin="0,1">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource QuestRowTemplate}" />
            </Button>
        </DataTemplate>

        <!-- planner line: row + "done" and "active" buttons -->
        <DataTemplate x:Key="CheckRow" DataType="{x:Type vm:QuestRow}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding Quest}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Background="Transparent" BorderThickness="0" Padding="4,2">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource QuestRowTemplate}" />
                </Button>
                <Button Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"
                        Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                            <Setter Property="Content" Value="{DynamicResource s.doneBtn}" />
                            <Setter Property="ToolTip" Value="{DynamicResource s.done.tip}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter Property="Content" Value="{DynamicResource s.undoneBtn}" />
                                    <Setter Property="ToolTip" Value="{DynamicResource s.undone.tip}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Column="2" Content="{DynamicResource s.activeBtn}" Style="{StaticResource SmallButton}" Margin="0" VerticalAlignment="Center"
                        ToolTip="{DynamicResource s.activeBtn.tip}"
                        Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />
            </Grid>
        </DataTemplate>

        <!-- "The Ticket" endings guide; DataContext = MainViewModel. Used by the End Game tab and the planner. -->
        <DataTemplate x:Key="TicketGuideView">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{DynamicResource s.tk.reset}" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                            VerticalAlignment="Top" Command="{Binding TicketResetCommand}" />
                    <TextBlock Text="{DynamicResource s.tk.desc}" Style="{StaticResource Muted}" />
                </DockPanel>

                <TextBlock Text="{DynamicResource s.tk.endings}" Style="{StaticResource H2}" />
                <ItemsControl ItemsSource="{Binding TicketEndings}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TicketEndingVm}">
                            <Border x:Name="card" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,6,0">
                                <DockPanel>
                                    <Button x:Name="targetBtn" DockPanel.Dock="Bottom" Content="{DynamicResource s.tk.setTarget}"
                                            Style="{StaticResource SmallButton}" Margin="0,8,0,0" HorizontalAlignment="Left"
                                            Command="{Binding DataContext.TicketTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Id}" />
                                    <TextBlock x:Name="state" DockPanel.Dock="Bottom" Text="{Binding StateText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineBrush}" BorderThickness="2" CornerRadius="3"
                                            HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <Image Source="{Binding Image}" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource H1}" FontSize="16" />
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsReachable}" Value="False">
                                    <Setter TargetName="card" Property="Opacity" Value="0.45" />
                                    <Setter TargetName="state" Property="Foreground" Value="{StaticResource DecisionBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRoute}" Value="True">
                                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource ActiveBrush}" />
                                    <Setter TargetName="state" Property="Foreground" Value="{StaticResource ActiveBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTarget}" Value="True">
                                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="card" Property="BorderThickness" Value="2" />
                                    <Setter TargetName="state" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="targetBtn" Property="Content" Value="{DynamicResource s.tk.unsetTarget}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding TicketSummary}" Style="{StaticResource Body}" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0" />
                <Border BorderBrush="{StaticResource DecisionBrush}" BorderThickness="2,0,0,0" Padding="8,2" Margin="0,6,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TicketWarning}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding TicketWarning}" Foreground="{StaticResource DecisionBrush}" TextWrapping="Wrap" />
                </Border>

                <DockPanel Margin="0,12,0,4">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding TicketProgressText}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource s.tk.route}" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding TicketSteps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TicketStepVm}">
                            <Border x:Name="card" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="3,0,0,0" CornerRadius="0,4,4,0" Padding="10,6" Margin="0,0,0,4">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{DynamicResource s.tk.here}" Foreground="{StaticResource ActiveBrush}"
                                                   FontWeight="Bold" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock x:Name="tag" DockPanel.Dock="Top" Text="{Binding Tag}" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,2"
                                                   Visibility="{Binding HasTag, Converter={StaticResource BoolToVis}}" />
                                        <Image DockPanel.Dock="Left" Source="{Binding Image}" Width="56" Height="56" Margin="0,2,10,0"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}" />
                                        <Grid VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" VerticalContentAlignment="Top"
                                                      Visibility="{Binding IsCheckable, Converter={StaticResource BoolToVis}}">
                                                <TextBlock x:Name="checkText" Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                                            </CheckBox>
                                            <TextBlock x:Name="plainText" Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"
                                                       Visibility="{Binding IsPlain, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Options}" Margin="0,6,0,0"
                                                  Visibility="{Binding IsDecision, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:TicketOptionVm}">
                                                <Button x:Name="opt" Margin="0,0,6,6" Padding="10,4" HorizontalContentAlignment="Left"
                                                        ToolTip="{DynamicResource s.tk.choiceTip}"
                                                        Command="{Binding DataContext.TicketChooseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel>
                                                        <TextBlock x:Name="mark" FontSize="10" FontWeight="Bold" Visibility="Collapsed" />
                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding EndingsText}" FontSize="11" Opacity="0.8" />
                                                    </StackPanel>
                                                </Button>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSuggested}" Value="True">
                                                        <Setter TargetName="mark" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="mark" Property="Text" Value="{DynamicResource s.tk.suggested}" />
                                                        <Setter TargetName="opt" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        <Setter TargetName="opt" Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsChosen}" Value="True">
                                                        <Setter TargetName="mark" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="mark" Property="Text" Value="{DynamicResource s.tk.chosen}" />
                                                        <Setter TargetName="opt" Property="Background" Value="{StaticResource AccentBrush}" />
                                                        <Setter TargetName="opt" Property="Foreground" Value="{StaticResource BgBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="decision">
                                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource DecisionBrush}" />
                                    <Setter TargetName="tag" Property="Foreground" Value="{StaticResource DecisionBrush}" />
                                    <Setter TargetName="plainText" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="achievement">
                                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource DoneBrush}" />
                                    <Setter TargetName="tag" Property="Foreground" Value="{StaticResource DoneBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="optional">
                                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource OptionalBrush}" />
                                    <Setter TargetName="tag" Property="Foreground" Value="{StaticResource OptionalBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="warning">
                                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource WarnBrush}" />
                                    <Setter TargetName="tag" Property="Foreground" Value="{StaticResource WarnBrush}" />
                                    <Setter TargetName="plainText" Property="Foreground" Value="{StaticResource WarnBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="note">
                                    <Setter TargetName="plainText" Property="Foreground" Value="{StaticResource MutedBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="escape">
                                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource LevelBrush}" />
                                    <Setter TargetName="tag" Property="Foreground" Value="{StaticResource LevelBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="ending">
                                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="tag" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="plainText" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="plainText" Property="FontSize" Value="16" />
                                    <Setter TargetName="plainText" Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter TargetName="checkText" Property="Foreground" Value="{StaticResource MutedBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="card" Property="Background" Value="#1F2A33" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{DynamicResource s.tk.source}" Style="{StaticResource Muted}" FontSize="10" Margin="0,8,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- PvP | PvE segmented switch: both visible, the selected one is filled -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="14,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- app size (Settings, or Ctrl + mouse wheel): the whole window, text and buttons alike -->
        <DockPanel.LayoutTransform>
            <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
        </DockPanel.LayoutTransform>
        <!-- top bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel>
                <TextBlock Text="◆ TARKOV QUEST TRACKER" Style="{StaticResource H1}" FontSize="16" VerticalAlignment="Center" />
                <TextBlock Text="{x:Static vm:MainViewModel.AppVersion}" Style="{StaticResource Muted}" FontSize="11"
                           VerticalAlignment="Center" Margin="8,3,0,0" />
                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,2,14,2">
                        <TextBlock Text="{DynamicResource s.profile}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding CurrentProfile}" MinWidth="120"
                                  ToolTip="{DynamicResource s.profile.tip}" />
                        <Button Content="+" Margin="4,0,0,0" Padding="10,4" ToolTip="{DynamicResource s.profile.newTip}" Click="NewProfile_Click" />
                    </StackPanel>

                    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="2" Margin="0,2,14,2" VerticalAlignment="Center" ToolTip="{DynamicResource s.mode.tip}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="PvP" GroupName="mode" Style="{StaticResource Segment}" IsChecked="{Binding IsPvp}" />
                            <RadioButton Content="PvE" GroupName="mode" Style="{StaticResource Segment}" IsChecked="{Binding IsPve}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,2,14,2">
                        <TextBlock Text="{DynamicResource s.appLang}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding UiLanguages}" DisplayMemberPath="Label" SelectedValuePath="Key"
                                  SelectedValue="{Binding UiLanguage}" MinWidth="100" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,14,2">
                        <TextBlock Text="{DynamicResource s.questLang}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Label" SelectedValuePath="Key"
                                  SelectedValue="{Binding Language}" MinWidth="100" />
                    </StackPanel>
                    <Button Content="{DynamicResource s.overlayToggle}" Margin="0,2" Click="ToggleOverlay_Click" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- a newer version on GitHub: one click downloads, installs and restarts -->
        <Border DockPanel.Dock="Top" Background="#2A2616" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,1" Padding="14,6"
                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{DynamicResource s.u.install}" Style="{StaticResource SmallButton}" Command="{Binding InstallUpdateCommand}"
                            IsEnabled="{Binding IsInstallingUpdate, Converter={StaticResource InvertBool}}" />
                    <Button Content="{DynamicResource s.u.notes}" Style="{StaticResource SmallButton}" Command="{Binding OpenReleaseNotesCommand}" />
                    <Button Content="✕" Style="{StaticResource SmallButton}" Margin="0" Command="{Binding DismissUpdateCommand}"
                            IsEnabled="{Binding IsInstallingUpdate, Converter={StaticResource InvertBool}}" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                    <Run Text="⬆" Foreground="{StaticResource AccentBrush}" />
                    <Run Text="{Binding UpdateText, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                    <Run Text="{Binding UpdateStatus, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- quests read off the in-game Tasks screen, waiting to be confirmed -->
        <Border DockPanel.Dock="Top" Background="#16222A" BorderBrush="{StaticResource ActiveBrush}" BorderThickness="0,0,0,1" Padding="14,6"
                Visibility="{Binding HasPendingImport, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{DynamicResource s.imp.review}" Style="{StaticResource SmallButton}" Click="ReviewImport_Click" />
                    <Button Content="✕" Style="{StaticResource SmallButton}" Margin="0" Command="{Binding ClearImportCommand}" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource ActiveBrush}" FontWeight="SemiBold"
                           Text="{Binding PendingImportText, Mode=OneWay}" />
            </DockPanel>
        </Border>

        <!-- toast -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" Padding="14,4" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{DynamicResource s.undo}" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                        Command="{Binding UndoCommand}" Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}" />
                <!-- always-visible shortcut reminder (the overlay's own hint is hard to read in game) -->
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"
                           ToolTip="{DynamicResource s.keys.barTip}">
                    <Run Text="⌨ " /><Run Text="{Binding Settings.ClickThroughHotkey, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                    <Run Text="{DynamicResource s.keys.barLock}" />
                    <Run Text="  ·  " /><Run Text="{Binding Settings.ToggleOverlayHotkey, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                    <Run Text="{DynamicResource s.keys.barToggle}" />
                    <Run Text="  ·  " /><Run Text="{Binding Settings.FleaSearchHotkey, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                    <Run Text="{DynamicResource s.keys.barFlea}" />
                    <Run Text="  ·  " /><Run Text="{Binding Settings.RaidHotkey, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                    <Run Text="{DynamicResource s.keys.barRaid}" />
                    <Run Text="  ·  " /><Run Text="{Binding Settings.ScanHotkey, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                    <Run Text="{DynamicResource s.keys.barScan}" />
                    <Run Text="  ·  " /><Run Text="Ctrl + 🖱" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                    <Run Text="{DynamicResource s.keys.barWheel}" />
                </TextBlock>
                <TextBlock Text="{Binding Toast}" Foreground="{StaticResource DoneBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SplitterColumn" Width="5" />
                <ColumnDefinition x:Name="DetailColumn" Width="430" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- pages as a left side menu: icon + name, the selected one gets an accent bar -->
            <TabControl x:Name="Pages" Margin="0,0,0,8" TabStripPlacement="Left" SelectionChanged="Pages_SelectionChanged">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="0,0,1,0" Padding="8,10" MinWidth="190">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Once" />
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="12,8,0,0" />
                        </DockPanel>
                    </ControlTemplate>
                </TabControl.Template>
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Margin="0,1" Padding="0,9,12,9">
                                        <DockPanel>
                                            <Border x:Name="Bar" DockPanel.Dock="Left" Width="3" CornerRadius="2" Margin="0,0,10,0" Background="Transparent" />
                                            <TextBlock DockPanel.Dock="Left" Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="16" Width="20" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                                            <TextBlock Text="{TemplateBinding Header}" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBrush}" />
                                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
                <!-- entering a raid: pick the map, the overlay shows its quests -->
                <TabItem Header="{DynamicResource s.tab.raid}" Tag="&#xE707;">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,8,0,0">
                            <!-- auto-detect from the exfil list (double "O"): the player's choice, first thing on the page -->
                            <Border Background="{StaticResource CardBrush}" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="2" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Content="{DynamicResource s.raid.autoOn}" GroupName="autoRaid" Style="{StaticResource Segment}"
                                                             IsChecked="{Binding AutoRaidDetect}" />
                                                <RadioButton Content="{DynamicResource s.raid.autoOff}" GroupName="autoRaid" Style="{StaticResource Segment}"
                                                             IsChecked="{Binding AutoRaidDetectOff}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{DynamicResource s.raid.auto}" Style="{StaticResource Body}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </DockPanel>
                                    <TextBlock Text="{DynamicResource s.raid.autoDesc}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RaidBanner}" />
                            <!-- Goon tracker: last reports for the PvP / PvE mode being played (tarkov-goon-tracker.com) -->
                            <Border Background="{StaticResource CardBrush}" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="⟳" Style="{StaticResource SmallButton}" Command="{Binding RefreshGoonsCommand}"
                                                    ToolTip="{DynamicResource s.goon.refresh}" AutomationProperties.Name="{DynamicResource s.goon.refresh}" />
                                            <Button Content="{DynamicResource s.goon.openSite}" Style="{StaticResource SmallButton}" Margin="0"
                                                    Command="{Binding OpenGoonSiteCommand}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center" TextWrapping="Wrap">
                                            <Run Text="{DynamicResource s.goon.title}" FontWeight="SemiBold" />
                                            <Run Text="{Binding ModeText, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                                            <Run Text="  " />
                                            <Run Text="{Binding GoonLastMap, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                                            <Run Text="{Binding GoonLastSeenText, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                                        </TextBlock>
                                    </DockPanel>
                                    <TextBlock Text="{Binding GoonStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding HasGoonStatus, Converter={StaticResource BoolToVis}}" />
                                    <ItemsControl ItemsSource="{Binding GoonRecent}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0">
                                                    <Run Text="{Binding MapName, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                                                    <Run Text="·" />
                                                    <Run Text="{Binding AgoText, Mode=OneWay}" />
                                                    <Run Text="{Binding Reporter, Mode=OneWay}" FontStyle="Italic" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <!-- BTR tracker: where the BTR should be by the raid clock, and when it reaches each stop -->
                            <Border Background="{StaticResource CardBrush}" CornerRadius="4" Padding="10,8" Margin="0,0,0,10"
                                    Visibility="{Binding BtrCardVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ComboBox ItemsSource="{Binding BtrRouteChoices}" SelectedIndex="{Binding BtrRouteIndex}" MinWidth="90" Margin="0,0,6,0"
                                                      ToolTip="{DynamicResource s.btr.routeTip}" />
                                            <Button Content="↺" Style="{StaticResource SmallButton}" Margin="0" Command="{Binding BtrResetCommand}"
                                                    ToolTip="{DynamicResource s.btr.reset}" AutomationProperties.Name="{DynamicResource s.btr.reset}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding BtrStatus}" Style="{StaticResource Body}" Foreground="{StaticResource AccentBrush}"
                                                   FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding BtrNote}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <ItemsControl ItemsSource="{Binding BtrStops}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:BtrStopRowVm}">
                                                <DockPanel Margin="0,1,0,0">
                                                    <Button DockPanel.Dock="Right" Content="{DynamicResource s.btr.seen}" Style="{StaticResource SmallButton}"
                                                            FontSize="11" Padding="6,0" Margin="8,0,0,0" CommandParameter="{Binding StopId}"
                                                            Command="{Binding DataContext.BtrSeenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            ToolTip="{DynamicResource s.btr.seenTip}" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding EtaText}" Style="{StaticResource Body}" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                                                        <Run Text="{Binding RouteId, Mode=OneWay}" />
                                                    </TextBlock>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{DynamicResource s.raid.pick}" Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="{DynamicResource s.raid.desc}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,10" />
                            <ItemsControl ItemsSource="{Binding RaidMaps}" ItemTemplate="{StaticResource MapCard}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- In-Game GPS: the player's position from the game's screenshot names, on the map window -->
                <TabItem x:Name="GpsTab" Header="{DynamicResource s.tab.gps}" Tag="&#xE81D;">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,8,0,0" MaxWidth="760" HorizontalAlignment="Left">
                            <!-- what it reads, before anything else -->
                            <Border Background="#18241A" BorderBrush="{StaticResource DoneBrush}" BorderThickness="1" CornerRadius="4"
                                    Padding="12,8" Margin="0,0,0,10">
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource Body}">
                                    <Run Text="✔ " Foreground="{StaticResource DoneBrush}" /><Run Text="{DynamicResource s.gps.notice}" Foreground="{StaticResource DoneBrush}" FontWeight="SemiBold" />
                                    <LineBreak /><Run Text="{DynamicResource s.gps.safe}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                </TextBlock>
                            </Border>

                            <!-- on / off, like the raid auto-detect -->
                            <Border Background="{StaticResource CardBrush}" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="2" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Content="{DynamicResource s.raid.autoOn}" GroupName="gps" Style="{StaticResource Segment}"
                                                             IsChecked="{Binding MapTracking}" />
                                                <RadioButton Content="{DynamicResource s.raid.autoOff}" GroupName="gps" Style="{StaticResource Segment}"
                                                             IsChecked="{Binding MapTrackingOff}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{DynamicResource s.gps.title}" Style="{StaticResource Body}" FontWeight="SemiBold"
                                                   FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </DockPanel>
                                    <TextBlock Text="{DynamicResource s.gps.desc}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- how the map shows: map window over the game, round mini map in a corner, or the app's map page -->
                            <Border Background="{StaticResource CardBrush}" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource s.gps.mode}" Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="15" />
                                    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4"
                                            Padding="2" Margin="0,6,0,6" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="{DynamicResource s.gps.mode.overlay}" GroupName="gpsMode" Style="{StaticResource Segment}"
                                                         IsChecked="{Binding GpsModeOverlay}" />
                                            <RadioButton Content="{DynamicResource s.gps.mode.mini}" GroupName="gpsMode" Style="{StaticResource Segment}"
                                                         IsChecked="{Binding GpsModeMini}" />
                                            <RadioButton Content="{DynamicResource s.gps.mode.app}" GroupName="gpsMode" Style="{StaticResource Segment}"
                                                         IsChecked="{Binding GpsModeApp}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{DynamicResource s.gps.mode.overlayDesc}" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                               Visibility="{Binding GpsModeOverlay, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{DynamicResource s.gps.mode.miniDesc}" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                               Visibility="{Binding GpsModeMini, Converter={StaticResource BoolToVis}}" />
                                    <DockPanel Visibility="{Binding GpsModeApp, Converter={StaticResource BoolToVis}}">
                                        <Button DockPanel.Dock="Right" Content="{DynamicResource s.gps.app.open}" Style="{StaticResource SmallButton}"
                                                Click="OpenMapTab_Click" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <TextBlock Text="{DynamicResource s.gps.mode.appDesc}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- how to use it -->
                            <Border Background="{StaticResource CardBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,10">
                                <StackPanel>
                                    <StackPanel.Resources>
                                        <Style x:Key="GpsStep" TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Setter Property="Margin" Value="0,3" />
                                        </Style>
                                    </StackPanel.Resources>
                                    <TextBlock Style="{StaticResource GpsStep}">
                                        <Run Text="1" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" /> <Run Text="{DynamicResource s.gps.step1}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource GpsStep}">
                                        <Run Text="2" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" /> <Run Text="{DynamicResource s.gps.step2}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource GpsStep}">
                                        <Run Text="3" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" /> <Run Text="{DynamicResource s.gps.step3}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource GpsStep}">
                                        <Run Text="4" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" /> <Run Text="{DynamicResource s.gps.step4}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- status: last position, open the map -->
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="12,10" Margin="0,0,0,10">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{DynamicResource s.map.set.open}" Style="{StaticResource SmallButton}" Command="{Binding ToggleMapCommand}" />
                                        <Button Content="⟳" Style="{StaticResource SmallButton}" ToolTip="{DynamicResource s.map.reload}"
                                                Command="{Binding ReloadScreenshotCommand}" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource s.gps.status}" Style="{StaticResource Muted}" FontSize="11" />
                                        <TextBlock Text="{Binding GpsStatus}" Style="{StaticResource Body}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- settings -->
                            <TextBlock Text="{DynamicResource s.gps.settings}" Style="{StaticResource H2}" />
                            <StackPanel IsEnabled="{Binding MapTracking}">
                                <CheckBox Content="{DynamicResource s.map.set.autoOpen}" IsChecked="{Binding MapOpenOnScreenshot}" Margin="0,4,0,4"
                                          Visibility="{Binding GpsModeOverlay, Converter={StaticResource BoolToVis}}" />
                                <CheckBox Content="{DynamicResource s.gps.mini.autoOpen}" IsChecked="{Binding MapOpenOnScreenshot}" Margin="0,4,0,4"
                                          Visibility="{Binding GpsModeMini, Converter={StaticResource BoolToVis}}" />
                                <CheckBox Content="{DynamicResource s.gps.exfils}" IsChecked="{Binding MapShowExtracts}" Margin="0,0,0,4" />
                                <CheckBox Content="{DynamicResource s.gps.quests}" IsChecked="{Binding MapShowQuests}" Margin="0,0,0,8" />
                                <CheckBox Content="{DynamicResource s.gps.cleanup}" IsChecked="{Binding MapCleanupScreenshots}" Margin="0,0,0,2" />
                                <StackPanel IsEnabled="{Binding MapCleanupScreenshots}" Margin="22,0,0,8">
                                    <TextBlock Text="{DynamicResource s.gps.cleanupDesc}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    <TextBlock Style="{StaticResource Body}">
                                        <Run Text="{DynamicResource s.gps.cleanupAfter}" /> <Run Text="{Binding MapCleanupMinutes, Mode=OneWay, StringFormat={}{0} min}" />
                                    </TextBlock>
                                    <Slider Minimum="1" Maximum="120" Value="{Binding MapCleanupMinutes}" IsSnapToTickEnabled="True" TickFrequency="1"
                                            SmallChange="1" LargeChange="5" MaxWidth="260" HorizontalAlignment="Left" Width="260" />
                                </StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{DynamicResource s.map.set.folder}" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,12,6" />
                                    <TextBox Grid.Column="1" Text="{Binding ScreenshotsFolder, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,6" />
                                    <TextBlock Grid.Row="1" Text="{DynamicResource s.ov.opacity}" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="0.3" Maximum="1" Value="{Binding MapOpacity}" MaxWidth="260"
                                            HorizontalAlignment="Left" Width="260" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>

                            <!-- BTR tracker: where it shows -->
                            <TextBlock Text="{DynamicResource s.gps.btr}" Style="{StaticResource H2}" />
                            <TextBlock Text="{DynamicResource s.gps.btrDesc}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <CheckBox Content="{DynamicResource s.gps.btrMap}" IsChecked="{Binding BtrShowOnMap}" Margin="0,4,0,4" />
                            <CheckBox Content="{DynamicResource s.gps.btrOverlay}" IsChecked="{Binding BtrShowInOverlay}" Margin="0,0,0,4" />
                            <CheckBox Content="{DynamicResource s.gps.btrCard}" IsChecked="{Binding BtrShowCard}" Margin="0,0,0,8" />

                            <!-- mini map: corner, size, zoom, turning, how long it stays -->
                            <StackPanel Visibility="{Binding GpsModeMini, Converter={StaticResource BoolToVis}}">
                                <DockPanel Margin="0,8,0,0">
                                    <Button DockPanel.Dock="Right" Content="{DynamicResource s.gps.mini.show}" Style="{StaticResource SmallButton}"
                                            Command="{Binding ToggleMapCommand}" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource s.gps.mini}" Style="{StaticResource H2}" />
                                </DockPanel>
                                <TextBlock Text="{DynamicResource s.gps.mini.corner}" Style="{StaticResource Body}" Margin="0,4,0,4" />
                                <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4"
                                        Padding="2" Margin="0,0,0,8" HorizontalAlignment="Left">
                                    <UniformGrid Columns="2">
                                        <RadioButton Content="{DynamicResource s.gps.mini.tl}" GroupName="miniCorner" Style="{StaticResource Segment}"
                                                     IsChecked="{Binding MiniMapTopLeft}" />
                                        <RadioButton Content="{DynamicResource s.gps.mini.tr}" GroupName="miniCorner" Style="{StaticResource Segment}"
                                                     IsChecked="{Binding MiniMapTopRight}" />
                                        <RadioButton Content="{DynamicResource s.gps.mini.bl}" GroupName="miniCorner" Style="{StaticResource Segment}"
                                                     IsChecked="{Binding MiniMapBottomLeft}" />
                                        <RadioButton Content="{DynamicResource s.gps.mini.br}" GroupName="miniCorner" Style="{StaticResource Segment}"
                                                     IsChecked="{Binding MiniMapBottomRight}" />
                                    </UniformGrid>
                                </Border>
                                <TextBlock Style="{StaticResource Body}">
                                    <Run Text="{DynamicResource s.gps.mini.size}" /> <Run Text="{Binding MiniMapSize, StringFormat={}{0:0} px, Mode=OneWay}" />
                                </TextBlock>
                                <Slider Minimum="140" Maximum="480" Value="{Binding MiniMapSize}" SmallChange="10" LargeChange="40" Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource Body}">
                                    <Run Text="{DynamicResource s.gps.mini.zoom}" /> <Run Text="{Binding MiniMapZoom, StringFormat={}{0:0.0}×, Mode=OneWay}" />
                                </TextBlock>
                                <Slider Minimum="1.5" Maximum="12" Value="{Binding MiniMapZoom}" SmallChange="0.5" LargeChange="1" Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource Body}">
                                    <Run Text="{DynamicResource s.gps.mini.seconds}" /> <Run Text="{Binding MiniMapSeconds, Mode=OneWay}" />
                                </TextBlock>
                                <Slider Minimum="3" Maximum="30" Value="{Binding MiniMapSeconds}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,6" />
                                <CheckBox Content="{DynamicResource s.gps.mini.rotate}" IsChecked="{Binding MiniMapRotate}" Margin="0,2,0,8" />
                            </StackPanel>

                            <!-- where the map window opens; dragging its top bar sets this too -->
                            <StackPanel Visibility="{Binding GpsModeOverlay, Converter={StaticResource BoolToVis}}">
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Content="{DynamicResource s.gps.center}" Style="{StaticResource SmallButton}"
                                        Command="{Binding CenterMapCommand}" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource s.gps.position}" Style="{StaticResource Body}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{DynamicResource s.gps.positionHint}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,4" />
                            <TextBlock Style="{StaticResource Body}">
                                <Run Text="{DynamicResource s.set.positionX}" /> <Run Text="{Binding MapPositionX, StringFormat={}{0:P0}, Mode=OneWay}" />
                            </TextBlock>
                            <Slider Minimum="0" Maximum="1" Value="{Binding MapPositionX}" Margin="0,0,0,6" />
                            <TextBlock Style="{StaticResource Body}">
                                <Run Text="{DynamicResource s.set.position}" /> <Run Text="{Binding MapPositionY, StringFormat={}{0:P0}, Mode=OneWay}" />
                            </TextBlock>
                            <Slider Minimum="0" Maximum="1" Value="{Binding MapPositionY}" Margin="0,0,0,6" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource s.gps.maps}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,8" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- In-Game GPS → Map ("in app" mode): the map window's map inside the app, always on, for a second monitor -->
                <TabItem x:Name="MapTab" Header="{DynamicResource s.tab.gpsMap}" Tag="&#xE81E;" FontSize="13" Margin="18,0,0,0"
                         Visibility="{Binding GpsModeApp, Converter={StaticResource BoolToVis}}" IsVisibleChanged="MapTab_IsVisibleChanged">
                    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6"
                            Margin="0,8,0,0">
                        <local:MapPanel x:Name="AppMap" Kind="App" />
                    </Border>
                </TabItem>

                <!-- search -->
                <TabItem Header="{DynamicResource s.tab.quests}" Tag="&#xE8FD;">
                    <DockPanel Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="15"
                                     ToolTip="{DynamicResource s.search.tip}" />
                            <WrapPanel Margin="0,6,0,6">
                                <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Label" SelectedValuePath="Key"
                                          SelectedValue="{Binding CategoryFilter}" MinWidth="140" Margin="0,0,8,4" />
                                <ComboBox ItemsSource="{Binding Filters}" DisplayMemberPath="Label" SelectedValuePath="Key"
                                          SelectedValue="{Binding Filter}" MinWidth="150" Margin="0,0,8,4" />
                                <ComboBox ItemsSource="{Binding Loyalties}" DisplayMemberPath="Label" SelectedValuePath="Key"
                                          SelectedValue="{Binding LoyaltyFilter}" MinWidth="110" Margin="0,0,8,4"
                                          ToolTip="{DynamicResource s.ll.tip}" />
                                <ComboBox ItemsSource="{Binding Traders}" SelectedValuePath="Key" SelectedValue="{Binding TraderFilter}"
                                          MinWidth="170" Margin="0,0,8,4">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <ContentPresenter Content="{Binding Key}" ContentTemplate="{StaticResource TraderAvatar}"
                                                                  Width="20" Height="20" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="4,0,0,4">
                                    <Run Text="{Binding SearchResults.Count, Mode=OneWay}" /> / <Run Text="{Binding SearchTotal, Mode=OneWay}" />
                                    <Run Text="{DynamicResource s.questCount}" />
                                </TextBlock>
                            </WrapPanel>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding SearchResults}" ItemTemplate="{StaticResource QuestRowTemplate}"
                                 SelectionChanged="QuestList_SelectionChanged" HorizontalContentAlignment="Stretch"
                                 Background="Transparent" VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.ScrollChanged="QuestList_ScrollChanged" />
                    </DockPanel>
                </TabItem>

                <!-- planner -->
                <TabItem Header="{DynamicResource s.tab.planner}" Tag="&#xE7C1;">
                    <DockPanel Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="{DynamicResource s.planner.ask}" Style="{StaticResource Body}" />
                            <TextBox Text="{Binding GoalSearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" FontSize="14"
                                     ToolTip="{DynamicResource s.planner.tip}" />
                            <ItemsControl ItemsSource="{Binding GoalSearchResults}" Margin="0,2,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type core:Quest}">
                                        <DockPanel Margin="0,1">
                                            <Button DockPanel.Dock="Right" Content="{DynamicResource s.goal.make}" Style="{StaticResource SmallButton}"
                                                    Command="{Binding DataContext.ToggleGoalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <ContentPresenter Content="{Binding Trader}" ContentTemplate="{StaticResource TraderAvatar}"
                                                              Width="22" Height="22" Margin="0,0,8,0" />
                                            <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center">
                                                <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="{Binding Trader, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{DynamicResource s.goals.mine}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox ItemsSource="{Binding Goals}" SelectedItem="{Binding SelectedGoal}" DisplayMemberPath="DisplayName" MinWidth="260" />
                                <Button Content="{DynamicResource s.goal.remove}" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                        Command="{Binding ToggleGoalCommand}" CommandParameter="{Binding SelectedGoal}" />
                            </StackPanel>
                            <TextBlock Text="{Binding GoalSummary}" Style="{StaticResource Body}" Margin="0,8,0,0" />
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Content="{DynamicResource s.activateAvailable}" Style="{StaticResource SmallButton}" Margin="0"
                                        Command="{Binding ActivateAvailableCommand}" CommandParameter="goal" />
                                <TextBlock Text="{DynamicResource s.availableNow}" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding GoalAvailable}" ItemTemplate="{StaticResource CheckRow}" />
                            <TextBlock Text="{DynamicResource s.chainAll}" Style="{StaticResource H2}" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding GoalChain}" ItemTemplate="{StaticResource CheckRow}" />
                                <!-- goal "The Ticket": its endings, decisions and the whole route with done / not done -->
                                <StackPanel Visibility="{Binding IsTicketGoal, Converter={StaticResource BoolToVis}}" Margin="0,8,6,0">
                                    <TextBlock Text="{DynamicResource s.tk.plannerTitle}" Style="{StaticResource H2}" FontSize="15" />
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TicketGuideView}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <!-- kappa -->
                <TabItem Header="{DynamicResource s.tab.kappa}" Tag="&#xE734;">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding KappaSummary}" Style="{StaticResource Body}" FontSize="14" />
                            <ProgressBar Value="{Binding KappaPercent, Mode=OneWay}" Maximum="100" Height="8" Margin="0,6,0,0" Foreground="{StaticResource KappaBrush}" />
                            <DockPanel Margin="0,12,0,0">
                                <Button DockPanel.Dock="Right" Content="{DynamicResource s.activateAll}" Style="{StaticResource SmallButton}" Margin="0"
                                        Command="{Binding ActivateAvailableCommand}" CommandParameter="kappa" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource s.kappa.available}" Style="{StaticResource H2}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <ComboBox ItemsSource="{Binding KappaGroupings}" DisplayMemberPath="Label" SelectedValuePath="Key"
                                              SelectedValue="{Binding KappaGroupBy}" MinWidth="200" />
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding KappaAvailable}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:MapGroup}">
                                        <Expander Header="{Binding Header}" IsExpanded="True" Margin="0,4,0,0" HorizontalAlignment="Stretch">
                                            <ItemsControl ItemsSource="{Binding Quests}" ItemTemplate="{StaticResource CheckRow}" Margin="8,0,0,0" />
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Expander Header="{DynamicResource s.kappa.remaining}" Margin="0,12,0,0">
                                <ItemsControl ItemsSource="{Binding KappaRemaining}" ItemTemplate="{StaticResource CheckRow}" />
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- quest items: trader → quest → items to hand over -->
                <TabItem Header="{DynamicResource s.tab.items}" Tag="&#xE7B8;">
                    <DockPanel Margin="0,8,0,0">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBox Text="{Binding ItemSearchText, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,12,4"
                                     ToolTip="{DynamicResource s.items.search}" />
                            <CheckBox Content="{DynamicResource s.items.hideDone}" IsChecked="{Binding ItemsHideDone}" Margin="0,0,12,4" VerticalAlignment="Center" />
                            <CheckBox Content="{DynamicResource s.items.firOnly}" IsChecked="{Binding ItemsFirOnly}" Margin="0,0,12,4" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ItemsSummary}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,0,4" />
                        </WrapPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ItemGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TraderItems}">
                                        <Expander IsExpanded="{Binding IsExpanded}" Margin="0,4,0,0">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentPresenter Content="{Binding Trader}" ContentTemplate="{StaticResource TraderAvatar}"
                                                                      Width="22" Height="22" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Header}" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Loaded}" Margin="8,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:QuestItemsRow}">
                                                        <StackPanel Margin="0,0,0,6">
                                                            <Button Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding Row.Quest}" HorizontalAlignment="Left"
                                                                    Background="Transparent" BorderThickness="0" Padding="0,1">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Row.Quest.DisplayName}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Row.Quest.LevelText, StringFormat='  {0}'}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
                                                                    <ContentPresenter Content="{Binding Row}" ContentTemplate="{StaticResource StatusPill}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ItemChip}" Margin="0,3,0,0">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <!-- active -->
                <TabItem Header="{DynamicResource s.tab.active}" Tag="&#xE768;">
                    <DockPanel Margin="0,8,0,0">
                        <DockPanel DockPanel.Dock="Top">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="{DynamicResource s.untrackAll}" Style="{StaticResource SmallButton}" Command="{Binding UntrackAllCommand}"
                                        ToolTip="{DynamicResource s.untrackAll.tip}" />
                                <Button Content="{DynamicResource s.clearAll}" Style="{StaticResource SmallButton}" Margin="0" Command="{Binding ClearActiveCommand}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding ActiveSummary}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource s.active.desc}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                        <!-- search + map: only the quests of one map, or the ones matching the words -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding ActiveMaps}" DisplayMemberPath="Label" SelectedValuePath="Key"
                                      SelectedValue="{Binding ActiveMap}" MinWidth="170" Margin="8,0,0,0" ToolTip="{DynamicResource a.mapTip}" />
                            <Button DockPanel.Dock="Right" Content="{DynamicResource a.clearFilter}" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                    Command="{Binding ClearActiveFilterCommand}"
                                    Visibility="{Binding IsActiveFiltered, Converter={StaticResource BoolToVis}}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ActiveShownText}" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                       Margin="8,0,0,0" Visibility="{Binding IsActiveFiltered, Converter={StaticResource BoolToVis}}" />
                            <TextBox Text="{Binding ActiveSearch, UpdateSourceTrigger=PropertyChanged}" FontSize="14" ToolTip="{DynamicResource a.searchTip}" />
                        </DockPanel>
                        <!-- entering a raid from here too: one small button per map -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RaidBanner}" />
                            <TextBlock Text="{DynamicResource s.raid.pick}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding RaidMaps}" ItemTemplate="{StaticResource MapChip}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource a.noMatch}" Style="{StaticResource Muted}" Margin="0,8,0,0"
                                   Visibility="{Binding HasNoActiveShown, Converter={StaticResource BoolToVis}}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{Binding ActiveShown}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ActiveQuestVm}">
                                        <Border x:Name="Card" Background="{StaticResource CardBrush}" CornerRadius="4" Padding="10,8" Margin="0,0,0,8"
                                                BorderBrush="Transparent" BorderThickness="3,0,0,0">
                                            <StackPanel>
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button x:Name="Pin" Content="{DynamicResource s.track}" Style="{StaticResource SmallButton}" ToolTip="{DynamicResource s.track.tip}"
                                                                Command="{Binding DataContext.ToggleTrackedCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Quest}" />
                                                        <Button Content="{DynamicResource s.finish}" Style="{StaticResource SmallButton}"
                                                                Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Quest}" />
                                                        <Button Content="{DynamicResource s.remove}" Style="{StaticResource SmallButton}"
                                                                Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Quest}" />
                                                        <Button Content="{DynamicResource s.details}" Style="{StaticResource SmallButton}" Margin="0"
                                                                Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Quest}" />
                                                    </StackPanel>
                                                    <ContentPresenter Content="{Binding Quest.Trader}" ContentTemplate="{StaticResource TraderAvatar}"
                                                                      Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center">
                                                        <Run Text="{Binding Quest.DisplayName, Mode=OneWay}" />
                                                        <Run Text="{Binding Quest.MapText, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" FontWeight="Normal" FontSize="12" />
                                                    </TextBlock>
                                                </DockPanel>
                                                <!-- what to bring into the raid, compact -->
                                                <ItemsControl ItemsSource="{Binding Quest.RaidNeedItems}" Margin="40,4,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type core:ItemNeed}">
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,8,0" ToolTip="{Binding ToolTip}">
                                                                <Image Source="{Binding IconPath, Converter={StaticResource ItemIcon}}" Width="22" Height="22" />
                                                                <TextBlock Text="{Binding CountText}" Foreground="{StaticResource WarnBrush}" FontSize="11"
                                                                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,0,0" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl ItemsSource="{Binding Objectives}" Margin="0,6,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:ObjectiveVm}">
                                                            <DockPanel Margin="0,2">
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                                            Visibility="{Binding IsCounter, Converter={StaticResource BoolToVis}}">
                                                                    <Button Content="−" Command="{Binding DecrementCommand}" Style="{StaticResource SmallButton}" />
                                                                    <TextBlock Text="{Binding CounterText}" Foreground="{StaticResource AccentBrush}" MinWidth="50"
                                                                               TextAlignment="Center" VerticalAlignment="Center" />
                                                                    <Button Content="+" Command="{Binding IncrementCommand}" Style="{StaticResource SmallButton}" Margin="6,0,0,0" />
                                                                </StackPanel>
                                                                <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}">
                                                                    <DockPanel>
                                                                        <Image Source="{Binding Objective.Item.IconPath, Converter={StaticResource ItemIcon}}"
                                                                               Style="{StaticResource ObjectiveIcon}" ToolTip="{Binding Objective.Item.ToolTip}" />
                                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                                                    </DockPanel>
                                                                </CheckBox>
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <!-- tracked = on the overlay -->
                                            <DataTrigger Binding="{Binding IsTracked}" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter TargetName="Pin" Property="Background" Value="{StaticResource AccentBrush}" />
                                                <Setter TargetName="Pin" Property="Foreground" Value="{StaticResource BgBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <!-- read the in-game Tasks screen (OCR): how-to, countdown while scanning, confirm list -->
                <TabItem x:Name="ScanTab" Header="{DynamicResource s.tab.scan}" Tag="&#xE722;">
                    <DockPanel Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Top" MaxWidth="760" HorizontalAlignment="Left">
                            <!-- what it does and does not do, before anything else -->
                            <Border Background="#2A2616" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1" CornerRadius="4"
                                    Padding="12,8" Margin="0,0,0,10">
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource Body}">
                                    <Run Text="⚠ " Foreground="{StaticResource WarnBrush}" /><Run Text="{DynamicResource s.scan.notice}" Foreground="{StaticResource WarnBrush}" FontWeight="SemiBold" />
                                    <LineBreak /><Run Text="{DynamicResource s.scan.safe}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                </TextBlock>
                            </Border>
                            <TextBlock Text="{DynamicResource s.scan.title}" Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="{DynamicResource s.scan.desc}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,10" />

                            <!-- how to use it -->
                            <Border Background="{StaticResource CardBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,10">
                                <StackPanel>
                                    <StackPanel.Resources>
                                        <Style x:Key="Step" TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Setter Property="Margin" Value="0,3" />
                                        </Style>
                                    </StackPanel.Resources>
                                    <TextBlock Style="{StaticResource Step}">
                                        <Run Text="1" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" /> <Run Text="{DynamicResource s.scan.step1}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Step}">
                                        <Run Text="2" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" /> <Run Text="{DynamicResource s.scan.step2}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Step}">
                                        <Run Text="3" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" /> <Run Text="{DynamicResource s.scan.step3}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Step}">
                                        <Run Text="4" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" /> <Run Text="{DynamicResource s.scan.step4}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0">
                                        <Run Text="{DynamicResource s.scan.once1}" />
                                        <Run Text="{Binding Settings.ScanHotkey, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                                        <Run Text="{DynamicResource s.scan.once2}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- status + countdown -->
                            <Border CornerRadius="4" Padding="12,10" Margin="0,0,0,10" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource CardBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                                <Setter Property="Background" Value="#16222A" />
                                                <Setter Property="BorderBrush" Value="{StaticResource ActiveBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="{Binding ScanButtonText}" Command="{Binding ToggleScanCommand}"
                                                Style="{StaticResource ActionButton}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ScanStatusText}" Style="{StaticResource Body}" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    </DockPanel>
                                    <ProgressBar Value="{Binding ScanRemaining, Mode=OneWay}" Maximum="1" Height="4" Margin="0,8,0,0"
                                                 Foreground="{StaticResource ActiveBrush}" Background="{StaticResource BgBrush}" BorderThickness="0"
                                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                                    <!-- what the last frame showed: a scan that finds nothing says why -->
                                    <TextBlock Text="{Binding ScanDiagnosis}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    <TextBlock Text="{DynamicResource s.scan.startHint}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    <Button Content="{DynamicResource s.scan.saveFrame}" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                            Command="{Binding SaveScanFrameCommand}" ToolTip="{DynamicResource s.scan.saveFrameTip}"
                                            Visibility="{Binding HasScanFrame, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Border>

                            <!-- confirm -->
                            <DockPanel Visibility="{Binding HasPendingImport, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="{DynamicResource imp.apply}" Style="{StaticResource SmallButton}" Command="{Binding ApplyImportCommand}" />
                                    <Button Content="{DynamicResource s.scan.clear}" Style="{StaticResource SmallButton}" Margin="0" Command="{Binding ClearImportCommand}" />
                                </StackPanel>
                                <TextBlock Text="{DynamicResource imp.desc}" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                            </DockPanel>
                        </StackPanel>


                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxWidth="760" HorizontalAlignment="Left">
                            <ItemsControl ItemsSource="{Binding ImportRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ImportRow}">
                                        <Border Background="{StaticResource CardBrush}" CornerRadius="4" Padding="10,6" Margin="0,0,0,4">
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalContentAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentPresenter Content="{Binding Trader}" ContentTemplate="{StaticResource TraderAvatar}"
                                                                      Width="22" Height="22" Margin="4,0,8,0" />
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Trader, StringFormat='  ·  {0}'}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding State, StringFormat='  ({0})'}" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center"
                                                               Visibility="{Binding HasState, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </CheckBox>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <!-- Story: every story chapter step by step, with its walkthrough and the choices made in it -->
                <TabItem x:Name="StoryTab" Header="{DynamicResource s.tab.story}" Tag="&#xE736;">
                    <DockPanel Margin="0,8,0,0">
                        <!-- the chapters -->
                        <DockPanel DockPanel.Dock="Left" Width="250" Margin="0,0,12,0">
                            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource s.st.desc}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <ListBox ItemsSource="{Binding StoryChapters}" SelectedItem="{Binding SelectedStoryChapter}" Background="Transparent"
                                     BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:StoryChapterVm}">
                                        <DockPanel Margin="2,4">
                                            <TextBlock x:Name="count" DockPanel.Dock="Right" Text="{Binding ProgressText}" Style="{StaticResource Muted}"
                                                       FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                                            <TextBlock x:Name="mark" DockPanel.Dock="Left" Text="○" Width="18" Foreground="{StaticResource MutedBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter TargetName="mark" Property="Text" Value="▶" />
                                                <Setter TargetName="mark" Property="Foreground" Value="{StaticResource ActiveBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                <Setter TargetName="mark" Property="Text" Value="✓" />
                                                <Setter TargetName="mark" Property="Foreground" Value="{StaticResource DoneBrush}" />
                                                <Setter TargetName="count" Property="Foreground" Value="{StaticResource DoneBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- the chapter: its steps, walkthrough and choices -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,8" DataContext="{Binding}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Style="{StaticResource SmallButton}" Command="{Binding StoryToggleActiveCommand}" Margin="0,0,6,0">
                                            <Button.Content>
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{DynamicResource s.st.activate}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StoryChapterActive}" Value="True">
                                                                    <Setter Property="Text" Value="{DynamicResource s.st.deactivate}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button.Content>
                                        </Button>
                                        <Button Content="{DynamicResource s.st.wiki}" Style="{StaticResource SmallButton}"
                                                Command="{Binding OpenWikiCommand}" CommandParameter="{Binding SelectedStoryChapter.Quest}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedStoryChapter.Name}" Style="{StaticResource H1}" />
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0">
                                            <Run Text="{Binding StoryProgressText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>

                                <!-- The Ticket has its own page -->
                                <Border Background="{StaticResource CardBrush}" CornerRadius="4" Padding="12,10" Margin="0,12,0,0"
                                        Visibility="{Binding StoryIsTicket, Converter={StaticResource BoolToVis}}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="{DynamicResource s.st.openTicket}" Style="{StaticResource SmallButton}"
                                                Command="{Binding OpenTicketGuideCommand}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <TextBlock Text="{DynamicResource s.st.ticket}" Style="{StaticResource Body}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding StorySteps}" Margin="0,12,0,0"
                                              Visibility="{Binding StoryShowsSteps, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:StoryStepVm}">
                                            <Border x:Name="card" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
                                                    BorderThickness="3,0,0,0" CornerRadius="0,4,4,0" Padding="10,6" Margin="0,0,0,4">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{DynamicResource s.tk.here}" Foreground="{StaticResource ActiveBrush}"
                                                                   FontWeight="Bold" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}" />
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0"
                                                                    Visibility="{Binding Objective.IsCounter, Converter={StaticResource BoolToVis}}">
                                                            <Button Content="−" Command="{Binding Objective.DecrementCommand}" Style="{StaticResource SmallButton}" />
                                                            <TextBlock Text="{Binding Objective.CounterText}" Foreground="{StaticResource AccentBrush}" MinWidth="44"
                                                                       TextAlignment="Center" VerticalAlignment="Center" />
                                                            <Button Content="+" Command="{Binding Objective.IncrementCommand}" Style="{StaticResource SmallButton}" Margin="6,0,0,0" />
                                                        </StackPanel>
                                                        <CheckBox IsChecked="{Binding Objective.IsDone, Mode=TwoWay}" VerticalContentAlignment="Top">
                                                            <TextBlock x:Name="text" Text="{Binding Objective.Text}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                                                        </CheckBox>
                                                    </DockPanel>
                                                    <!-- how to do it: the wiki walkthrough for this objective -->
                                                    <Expander Header="{DynamicResource s.st.how}" Margin="26,4,0,0" Foreground="{StaticResource MutedBrush}"
                                                              IsExpanded="{Binding IsCurrent, Mode=OneTime}"
                                                              Visibility="{Binding HasHelp, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding Help}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontSize="12.5"
                                                                   Margin="0,4,0,2" />
                                                    </Expander>
                                                    <!-- a choice made here -->
                                                    <Border BorderBrush="{StaticResource DecisionBrush}" BorderThickness="2,0,0,0" Padding="10,4,0,2" Margin="26,6,0,2"
                                                            Visibility="{Binding HasDecision, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel>
                                                            <TextBlock Text="{DynamicResource s.st.choice}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource DecisionBrush}" />
                                                            <TextBlock Text="{Binding Decision.Title}" Style="{StaticResource Body}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Decision.Note}" Foreground="{StaticResource DecisionBrush}" FontSize="12" TextWrapping="Wrap"
                                                                       Margin="0,2,0,0" Visibility="{Binding Decision.HasNote, Converter={StaticResource BoolToVis}}" />
                                                            <ItemsControl ItemsSource="{Binding Decision.Options}" Margin="0,6,0,0">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type vm:StoryOptionVm}">
                                                                        <Button x:Name="opt" Margin="0,0,6,6" Padding="10,4" HorizontalContentAlignment="Left" MaxWidth="320"
                                                                                ToolTip="{DynamicResource s.tk.choiceTip}"
                                                                                Command="{Binding DataContext.StoryChooseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}">
                                                                            <StackPanel>
                                                                                <TextBlock x:Name="mark" Text="{DynamicResource s.st.chosen}" FontSize="10" FontWeight="Bold"
                                                                                           Foreground="{StaticResource AccentBrush}" Visibility="Collapsed" />
                                                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                                <TextBlock Text="{Binding Rewards}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                                                                            </StackPanel>
                                                                        </Button>
                                                                        <DataTemplate.Triggers>
                                                                            <DataTrigger Binding="{Binding IsChosen}" Value="True">
                                                                                <Setter TargetName="mark" Property="Visibility" Value="Visible" />
