                                    <TextBlock Text="{DynamicResource s.help.q8.a}" Style="{StaticResource HelpText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HelpCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource s.help.q9.q}" Style="{StaticResource HelpHead}" />
                                    <TextBlock Text="{DynamicResource s.help.q9.a}" Style="{StaticResource HelpText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HelpCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource s.help.q10.q}" Style="{StaticResource HelpHead}" />
                                    <TextBlock Text="{DynamicResource s.help.q10.a}" Style="{StaticResource HelpText}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{DynamicResource s.help.about.disclaimer}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <GridSplitter x:Name="DetailSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- detail panel -->
            <Border x:Name="DetailPanel" Grid.Column="2" Background="{StaticResource PanelBrush}" Margin="0,8,8,8" CornerRadius="6" Padding="14,10">
                <Grid>
                    <TextBlock Text="{DynamicResource s.selectQuest}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel>
                                <ContentPresenter Content="{Binding SelectedQuest.Trader}" ContentTemplate="{StaticResource TraderAvatar}"
                                                  Width="56" Height="56" Margin="0,0,12,0" VerticalAlignment="Top" />
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedQuest.DisplayName}" Style="{StaticResource H1}" />
                                    <TextBlock Text="{Binding SelectedOtherNames}" Style="{StaticResource Muted}" />
                                </StackPanel>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <ContentPresenter Content="{Binding SelectedRow}" ContentTemplate="{StaticResource StatusPill}" />
                                <TextBlock Text="{DynamicResource s.kappaRequired}" Foreground="{StaticResource KappaBrush}" FontWeight="SemiBold"
                                           Visibility="{Binding SelectedQuest.IsKappa, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding SelectedRow.CategoryBadge, StringFormat='  {0}'}" Foreground="{StaticResource ActiveBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedQuest.EventName}" Style="{StaticResource Muted}" />
                            <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0">
                                <Run Text="{DynamicResource s.trader}" Foreground="{StaticResource MutedBrush}" /><Run Text="{Binding SelectedQuest.Trader, Mode=OneWay}" />
                                <LineBreak />
                                <Run Text="{DynamicResource s.map}" Foreground="{StaticResource MutedBrush}" /><Run Text="{Binding SelectedQuest.MapText, Mode=OneWay}" />
                                <LineBreak />
                                <Run Text="{DynamicResource s.lvl}" Foreground="{StaticResource MutedBrush}" /><Run Text="{Binding SelectedQuest.MinLevel, Mode=OneWay, TargetNullValue=-}" />
                                <Run Text="   Trader LL: " Foreground="{StaticResource MutedBrush}" /><Run Text="{Binding SelectedQuest.TraderLoyalty, Mode=OneWay, TargetNullValue=-}" />
                            </TextBlock>

                            <!-- action buttons: outlined when off, filled with their colour when the quest is in that state -->
                            <WrapPanel Margin="0,12,0,4">
                                <Button Command="{Binding ToggleActiveCommand}" CommandParameter="{Binding SelectedQuest}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                            <Setter Property="Foreground" Value="{StaticResource ActiveBrush}" />
                                            <Setter Property="Content" Value="{DynamicResource s.btn.active.on}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedRow.Status}" Value="Active">
                                                    <Setter Property="Background" Value="{StaticResource ActiveBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource ActiveBrush}" />
                                                    <Setter Property="Content" Value="{DynamicResource s.btn.active.off}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Command="{Binding ToggleCompleteCommand}" CommandParameter="{Binding SelectedQuest}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                            <Setter Property="Foreground" Value="{StaticResource DoneBrush}" />
                                            <Setter Property="Content" Value="{DynamicResource s.btn.complete.on}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedRow.IsDone}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource DoneBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource DoneBrush}" />
                                                    <Setter Property="Content" Value="{DynamicResource s.btn.complete.off}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Command="{Binding ToggleGoalCommand}" CommandParameter="{Binding SelectedQuest}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Content" Value="{DynamicResource s.btn.goal.on}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedRow.IsGoal}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    <Setter Property="Content" Value="{DynamicResource s.btn.goal.off}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Wiki ↗" Style="{StaticResource ActionButton}" Foreground="{StaticResource TextBrush}" MinWidth="90"
                                        Command="{Binding OpenWikiCommand}" CommandParameter="{Binding SelectedQuest}" />
                                <Button Content="{DynamicResource s.tk.openGuide}" Style="{StaticResource ActionButton}" Foreground="{StaticResource OptionalBrush}"
                                        Click="OpenTicketGuide_Click" Visibility="{Binding IsTicketSelected, Converter={StaticResource BoolToVis}}" />
                            </WrapPanel>

                            <ItemsControl ItemsSource="{Binding SelectedQuest.ModeWarnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource WarnBrush}" BorderThickness="2,0,0,0" Padding="8,2" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- keys, markers, items to plant, weapon, clothes: what to take into the raid -->
                            <Border BorderBrush="{StaticResource WarnBrush}" BorderThickness="2,0,0,0" Padding="8,4" Margin="0,8,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedQuest.RaidNeeds.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedQuest}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource s.raidNeeds}" Foreground="{StaticResource WarnBrush}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding SelectedQuest.RaidNeeds}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type core:RaidNeedGroup}">
                                                <DockPanel Margin="0,0,0,2">
                                                    <TextBlock DockPanel.Dock="Left" Width="100" Margin="0,10,6,0" FontSize="12" Foreground="{StaticResource MutedBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="key"><Setter Property="Text" Value="{DynamicResource s.need.key}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="mark"><Setter Property="Text" Value="{DynamicResource s.need.mark}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="plantItem"><Setter Property="Text" Value="{DynamicResource s.need.plant}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="useWeapon"><Setter Property="Text" Value="{DynamicResource s.need.weapon}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="wear"><Setter Property="Text" Value="{DynamicResource s.need.wear}" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ItemChip}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{DynamicResource s.objectives}" Style="{StaticResource H2}" />
                            <ItemsControl ItemsSource="{Binding SelectedQuest.Objectives}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type core:Objective}">
                                        <StackPanel Margin="0,2">
                                            <DockPanel>
                                                <Image Source="{Binding Item.IconPath, Converter={StaticResource ItemIcon}}" Style="{StaticResource ObjectiveIcon}"
                                                       ToolTip="{Binding Item.ToolTip}" />
                                                <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center">
                                                    <Run Text="• " /><Run Text="{Binding DisplayText, Mode=OneWay}" />
                                                </TextBlock>
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding DisplayDetails}" Margin="14,0,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Style="{StaticResource Muted}" FontSize="12" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{DynamicResource s.reqItems}" Style="{StaticResource H2}" />
                            <ItemsControl ItemsSource="{Binding SelectedQuest.ItemNeeds}" ItemTemplate="{StaticResource ItemChip}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <TextBlock Text="{DynamicResource s.prereqs}" Style="{StaticResource H2}" />
                            <ItemsControl ItemsSource="{Binding SelectedPrerequisites}" ItemTemplate="{StaticResource LinkRow}" />
                            <TextBlock Text="{DynamicResource s.unlocks}" Style="{StaticResource H2}" />
                            <ItemsControl ItemsSource="{Binding SelectedUnlocks}" ItemTemplate="{StaticResource LinkRow}" />

                            <TextBlock Text="{DynamicResource s.rewards}" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Body}">
                                <Run Text="{Binding SelectedQuest.Rewards.Xp, Mode=OneWay, StringFormat={}{0:N0} EXP}" />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding SelectedQuest.Rewards.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Muted}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{DynamicResource s.guide}" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding SelectedQuest.DisplayGuide}" Style="{StaticResource Body}" FontSize="12" />
                            <TextBlock Text="{Binding SelectedQuest.DisplayNotes}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding SelectedSources}" Style="{StaticResource Muted}" FontSize="10" Margin="0,12,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
