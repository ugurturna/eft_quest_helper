<Application x:Class="TarkovQuestTracker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TarkovQuestTracker.ViewModels"
             xmlns:local="clr-namespace:TarkovQuestTracker"
             xmlns:core="clr-namespace:TarkovQuestTracker.Core.Models;assembly=TarkovQuestTracker.Core"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#141412" />
        <SolidColorBrush x:Key="PanelBrush" Color="#1D1D1A" />
        <SolidColorBrush x:Key="CardBrush" Color="#25251F" />
        <SolidColorBrush x:Key="LineBrush" Color="#3A3A31" />
        <SolidColorBrush x:Key="TextBrush" Color="#DDD7C4" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8E897A" />
        <SolidColorBrush x:Key="AccentBrush" Color="#C2AE72" />
        <SolidColorBrush x:Key="DoneBrush" Color="#78A85E" />
        <SolidColorBrush x:Key="ActiveBrush" Color="#5FA2DB" />
        <SolidColorBrush x:Key="AvailableBrush" Color="#C2AE72" />
        <SolidColorBrush x:Key="LevelBrush" Color="#D98E3A" />
        <SolidColorBrush x:Key="LockedBrush" Color="#6B675C" />
        <SolidColorBrush x:Key="KappaBrush" Color="#B79BE0" />
        <SolidColorBrush x:Key="WarnBrush" Color="#E0A040" />
        <!-- Ticket endings guide: point-of-no-return decisions and optional achievements -->
        <SolidColorBrush x:Key="DecisionBrush" Color="#D9605A" />
        <SolidColorBrush x:Key="OptionalBrush" Color="#C98BB9" />

        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InvertBoolConverter x:Key="InvertBool" />
        <local:TraderImageConverter x:Key="TraderImage" />
        <local:InitialConverter x:Key="Initial" />
        <local:ItemIconConverter x:Key="ItemIcon" />

        <!-- small item icon in front of an objective; hidden when the objective has no item -->
        <Style x:Key="ObjectiveIcon" TargetType="Image">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style.Triggers>
                <Trigger Property="Source" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- one needed item: icon, short name, count, FIR; full name + alternatives in the tooltip -->
        <DataTemplate x:Key="ItemChip" DataType="{x:Type core:ItemNeed}">
            <Border Background="{StaticResource CardBrush}" CornerRadius="3" Padding="2,2,6,2" Margin="0,0,4,4" ToolTip="{Binding ToolTip}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding IconPath, Converter={StaticResource ItemIcon}}" Width="32" Height="32" />
                    <StackPanel VerticalAlignment="Center" Margin="5,0,0,0">
                        <TextBlock Text="{Binding ShortName}" Foreground="{StaticResource TextBrush}" FontSize="11"
                                   MaxWidth="110" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CountText}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text=" FIR" Foreground="{StaticResource WarnBrush}" FontSize="10" VerticalAlignment="Center"
                                       Visibility="{Binding Fir, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding MoreText, StringFormat=' {0}'}" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- trader portrait (content = trader name); size comes from the ContentPresenter -->
        <DataTemplate x:Key="TraderAvatar">
            <Grid ToolTip="{Binding}">
                <Border CornerRadius="4" Background="{StaticResource LineBrush}">
                    <Viewbox Margin="4">
                        <TextBlock Text="{Binding Converter={StaticResource Initial}}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                    </Viewbox>
                </Border>
                <Border CornerRadius="4">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Converter={StaticResource TraderImage}}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Grid>
        </DataTemplate>

        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- small button with a visible raised surface (the Fluent default is dark-on-dark and reads as a label);
             Background / BorderBrush / Foreground can still be overridden, e.g. the pinned 📌 Overlay button -->
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#34342C" />
            <Setter Property="BorderBrush" Value="#55554A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root">
                            <Border x:Name="bd" CornerRadius="4" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                            <Border x:Name="hover" CornerRadius="4" Background="White" Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hover" Property="Opacity" Value="0.08" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="hover" Property="Opacity" Value="0.16" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="root" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- big outlined action button; Foreground is the accent colour (border + text).
             A DataTrigger can flip it to "on" by setting Background to the accent and Foreground to BgBrush. -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root">
                            <Border x:Name="bd" CornerRadius="5" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                            <!-- filled with its own colour so it reads as a button, not an outlined label -->
                            <Border x:Name="tint" CornerRadius="5" Background="{TemplateBinding Foreground}" Opacity="0.24" />
                            <Border x:Name="hover" CornerRadius="5" Background="White" Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tint" Property="Opacity" Value="0.40" />
                                <Setter TargetName="hover" Property="Opacity" Value="0.06" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="hover" Property="Opacity" Value="0.20" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderThickness" Value="2.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="root" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- one map of the "entering a raid" picker: big map name, active quest count; click = start the raid there -->
        <DataTemplate x:Key="MapCard" DataType="{x:Type vm:MapCardVm}">
            <Button Command="{Binding DataContext.StartRaidCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding Name}" Cursor="Hand" Margin="0,0,8,8" ToolTip="{Binding CountText}"
                    AutomationProperties.Name="{Binding Name}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Width="200" Height="113" CornerRadius="5" ClipToBounds="True"
                                Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="2">
                            <StackPanel VerticalAlignment="Center" Margin="8,0">
                                <Viewbox StretchDirection="DownOnly" MaxHeight="40">
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontWeight="Bold" FontSize="26" />
                                </Viewbox>
                                <TextBlock x:Name="Count" Text="{Binding CountText}" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                                <!-- the Goon tracker's newest report is on this map -->
                                <Border Background="#5A2020" CornerRadius="3" Padding="6,1" Margin="0,5,0,0" HorizontalAlignment="Center"
                                        Visibility="{Binding IsGoonMap, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{DynamicResource s.goon.badge}" Foreground="#FFD0C0" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasQuests}" Value="True">
                                <Setter TargetName="Count" Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasQuests}" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.55" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource MutedBrush}" />
                                <Setter TargetName="Frame" Property="Opacity" Value="1" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Frame" Property="Opacity" Value="1" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- small map button ("Customs 5") for the Active Quests page -->
        <DataTemplate x:Key="MapChip" DataType="{x:Type vm:MapCardVm}">
            <Button x:Name="Chip" Command="{Binding DataContext.StartRaidCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding Name}" Style="{StaticResource SmallButton}" Margin="0,0,6,6" Padding="8,3"
                    ToolTip="{Binding CountText}" AutomationProperties.Name="{Binding Name}">
                <TextBlock>
                    <Run Text="{Binding Name, Mode=OneWay}" />
                    <Run Text="{Binding ActiveCount, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                </TextBlock>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasQuests}" Value="False">
                    <Setter TargetName="Chip" Property="Opacity" Value="0.55" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="Chip" Property="Foreground" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- "in a raid on Customs: 5 quests on the overlay · [Raid over]"; content = MainViewModel -->
        <DataTemplate x:Key="RaidBanner">
            <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="3,0,0,0" Background="{StaticResource CardBrush}"
                    CornerRadius="4" Padding="10,6" Margin="0,0,0,8"
                    Visibility="{Binding IsInRaid, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <!-- the banner's one action: filled accent so it stands out -->
                    <Button DockPanel.Dock="Right" Content="{DynamicResource s.raid.end}" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                            Padding="14,5" FontSize="13" FontWeight="SemiBold" Background="{StaticResource AccentBrush}"
                            BorderBrush="{StaticResource AccentBrush}" Foreground="{StaticResource BgBrush}"
                            Command="{Binding EndRaidCommand}" />
                    <TextBlock Text="{Binding RaidSummary}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- coloured status pill for QuestRow -->
        <DataTemplate x:Key="StatusPill" DataType="{x:Type vm:QuestRow}">
            <Border x:Name="pill" CornerRadius="3" Padding="6,1" Background="{StaticResource LockedBrush}">
                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#141412" FontWeight="SemiBold" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Done">
                    <Setter TargetName="pill" Property="Background" Value="{StaticResource DoneBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Active">
                    <Setter TargetName="pill" Property="Background" Value="{StaticResource ActiveBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Available">
                    <Setter TargetName="pill" Property="Background" Value="{StaticResource AvailableBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- one quest line: name, trader · map, badges -->
        <DataTemplate x:Key="QuestRowTemplate" DataType="{x:Type vm:QuestRow}">
            <Grid Margin="2,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding Quest.Trader}" ContentTemplate="{StaticResource TraderAvatar}"
                                  Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Quest.DisplayName}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Quest.LoyaltyText, StringFormat='  {0}'}" Foreground="{StaticResource LevelBrush}" FontSize="10"
                                   FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="Trader loyalty level" />
                        <TextBlock Text="  KAPPA" Foreground="{StaticResource KappaBrush}" FontSize="10" VerticalAlignment="Center"
                                   Visibility="{Binding Quest.IsKappa, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{DynamicResource s.goalTag}" Foreground="{StaticResource AccentBrush}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Visibility="{Binding IsGoal, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding CategoryBadge, StringFormat='  {0}'}" Foreground="{StaticResource ActiveBrush}" FontSize="10" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" FontSize="11">
                        <Run Text="{Binding Quest.Trader, Mode=OneWay}" /> · <Run Text="{Binding Quest.MapText, Mode=OneWay}" />
                        <Run Text="{Binding Quest.LevelText, Mode=OneWay}" Foreground="{StaticResource LevelBrush}" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
                <ContentPresenter Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource StatusPill}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Application.Resources>
</Application>
