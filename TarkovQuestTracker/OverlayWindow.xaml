<Window x:Class="TarkovQuestTracker.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TarkovQuestTracker.ViewModels"
        Title="Tarkov Tracker Overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        SizeToContent="WidthAndHeight"
        Opacity="{Binding OverlayOpacity}">
    <Border x:Name="Root" Background="#E0141412" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
            CornerRadius="6" Padding="10,8" Width="{Binding OverlayWidth}" PreviewMouseWheel="Root_PreviewMouseWheel">
        <Border.LayoutTransform>
            <ScaleTransform ScaleX="{Binding OverlayScale}" ScaleY="{Binding OverlayScale}" />
        </Border.LayoutTransform>
        <StackPanel>
            <!-- header: drag to move vertically (stays docked to the right edge) -->
            <Grid x:Name="Header" Background="Transparent" Cursor="SizeNS" ToolTip="{DynamicResource s.ov.dragTip}"
                  MouseLeftButtonDown="Header_MouseDown" MouseMove="Header_MouseMove" MouseLeftButtonUp="Header_MouseUp">
                <TextBlock FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="13">
                    <Run Text="◆ TARKOV TRACKER" /> <Run Text="{Binding ModeText, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                </TextBlock>
                <TextBlock x:Name="LockText" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource MutedBrush}" />
            </Grid>

            <Grid x:Name="Controls" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource s.ov.opacity}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Slider Grid.Column="1" Minimum="0.15" Maximum="1" Value="{Binding OverlayOpacity}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Grid.RowSpan="2" Content="{DynamicResource s.ov.hide}" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                        VerticalAlignment="Center" Click="Hide_Click" />
                <TextBlock Grid.Row="1" Text="{DynamicResource s.ov.size}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"
                           ToolTip="{DynamicResource s.ov.sizeTip}" />
                <Slider Grid.Row="1" Grid.Column="1" Minimum="0.6" Maximum="2" Value="{Binding OverlayScale}" VerticalAlignment="Center"
                        ToolTip="{DynamicResource s.ov.sizeTip}" />
            </Grid>

            <!-- in a raid: which map, ✕ ends it -->
            <DockPanel Margin="0,6,0,0" Visibility="{Binding IsInRaid, Converter={StaticResource BoolToVis}}">
                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource SmallButton}" FontSize="11" Padding="5,0" Margin="0"
                        ToolTip="{DynamicResource s.raid.end}" Command="{Binding EndRaidCommand}" />
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center">
                    <Run Text="🎯" /> <Run Text="{Binding RaidMap, Mode=OneWay}" />
                </TextBlock>
                <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                           Visibility="{Binding HasRaidTime, Converter={StaticResource BoolToVis}}" ToolTip="{DynamicResource s.raid.timeTip}">
                    <Run Text="⏱" /> <Run Text="{Binding RaidTimeLeft, Mode=OneWay}" />
                </TextBlock>
            </DockPanel>

            <!-- raid hotkey: pick the map without leaving the game -->
            <Border x:Name="MapPicker" Visibility="Collapsed" Margin="0,6,0,0" Padding="6" CornerRadius="4" Background="#C025251F">
                <StackPanel>
                    <TextBlock Text="{DynamicResource s.raid.pick}" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding RaidMaps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MapCardVm}">
                                <Button Style="{StaticResource SmallButton}" FontSize="11" Padding="6,2" Margin="0,0,4,4"
                                        Click="PickMap_Click" Tag="{Binding Name}" ToolTip="{Binding CountText}"
                                        AutomationProperties.Name="{Binding Name}">
                                    <TextBlock>
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                        <Run Text="{Binding ActiveCount, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" />
                                    </TextBlock>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Toast}" Foreground="{StaticResource DoneBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />

            <TextBlock Text="{DynamicResource s.ov.empty}" Margin="0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasOverlayQuests}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                <ItemsControl ItemsSource="{Binding OverlayQuests}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ActiveQuestVm}">
                            <Border Background="#C025251F" CornerRadius="4" Padding="8,6" Margin="0,0,0,6"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="6,0,0,0">
                                            <Button Content="{DynamicResource s.finish}" Style="{StaticResource SmallButton}" FontSize="11" Padding="6,0"
                                                    Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Quest}" />
                                            <Button Content="✕" Style="{StaticResource SmallButton}" FontSize="11" Padding="5,0" Margin="0"
                                                    ToolTip="{DynamicResource s.ov.removeTip}"
                                                    Command="{Binding DataContext.ToggleTrackedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Quest}" />
                                        </StackPanel>
                                        <ContentPresenter Content="{Binding Quest.Trader}" ContentTemplate="{StaticResource TraderAvatar}"
                                                          Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding Quest.DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <StackPanel Visibility="{Binding DataContext.OverlayDetailed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                    <TextBlock FontSize="11" Style="{StaticResource Muted}">
                                        <Run Text="{Binding Quest.Trader, Mode=OneWay}" /> · <Run Text="{Binding Quest.MapText, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" />
                                        · <Run Text="{Binding Progress, Mode=OneWay}" />
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Objectives}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ObjectiveVm}">
                                                <Grid x:Name="ObjRow" Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" VerticalAlignment="Top" MinWidth="0" MinHeight="0"
                                                              Margin="0,1,6,0" Padding="0" />
                                                    <StackPanel Grid.Column="1">
                                                        <DockPanel>
                                                            <Image Source="{Binding Objective.Item.IconPath, Converter={StaticResource ItemIcon}}"
                                                                   Style="{StaticResource ObjectiveIcon}" Width="22" Height="22" />
                                                            <TextBlock x:Name="ObjText" Text="{Binding Text}" FontSize="12" TextWrapping="Wrap"
                                                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                                        </DockPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                                    Visibility="{Binding IsCounter, Converter={StaticResource BoolToVis}}">
                                                            <Button Content="−" Command="{Binding DecrementCommand}" Style="{StaticResource SmallButton}" Padding="7,0" />
                                                            <TextBlock Text="{Binding CounterText}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                                                       MinWidth="40" TextAlignment="Center" FontWeight="SemiBold" />
                                                            <Button Content="+" Command="{Binding IncrementCommand}" Style="{StaticResource SmallButton}" Padding="7,0" Margin="6,0,0,0" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                        <Setter TargetName="ObjText" Property="Foreground" Value="{StaticResource DoneBrush}" />
                                                        <Setter TargetName="ObjText" Property="TextDecorations" Value="Strikethrough" />
                                                    </DataTrigger>
                                                    <!-- done objectives off the overlay (setting, on by default) -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsDone}" Value="True" />
                                                            <Condition Binding="{Binding DataContext.OverlayHideDoneObjectives, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter TargetName="ObjRow" Property="Visibility" Value="Collapsed" />
                                                    </MultiDataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- more quests than the overlay may show (setting) -->
            <TextBlock Text="{Binding OverlayHiddenText}" Style="{StaticResource Muted}" FontSize="11" Margin="2,0,0,2"
                       Visibility="{Binding HasOverlayHidden, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Border>
</Window>
