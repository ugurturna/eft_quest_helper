<UserControl x:Class="TarkovQuestTracker.MapPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- the raid's map with the player on it: the map window, the app's map page and the round mini map all show this -->
    <DockPanel>
        <!-- header: on the map window, drag it to move the window -->
        <DockPanel x:Name="Header" DockPanel.Dock="Top" Margin="8,6,6,4" Background="Transparent">
            <!-- the map window's own buttons (Esc hint, close) -->
            <StackPanel x:Name="WindowButtons" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="{DynamicResource s.flea.esc}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0" />
                <Button x:Name="CloseButton" Content="✕" Style="{StaticResource SmallButton}" FontSize="11" Padding="6,0" Margin="4,0,0,0"
                        ToolTip="{DynamicResource s.map.close}" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="⟳" Style="{StaticResource SmallButton}" FontSize="12" Padding="6,0" Margin="4,0,0,0"
                    ToolTip="{DynamicResource s.map.reload}" Command="{Binding ReloadScreenshotCommand}" />
            <ToggleButton x:Name="Follow" DockPanel.Dock="Right" Content="◎" FontSize="13" Padding="6,0" Margin="4,0,0,0" IsChecked="True"
                          ToolTip="{DynamicResource s.map.follow}" Checked="Follow_Checked" />
            <WrapPanel VerticalAlignment="Center">
                <!-- the grip: drag the top bar to move the window -->
                <TextBlock x:Name="Grip" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Run x:Name="GripDots" Text="⠿ " Foreground="{StaticResource MutedBrush}" /><Run Text="◆" /> <Run Text="{DynamicResource s.map.title}" />
                </TextBlock>
                <ComboBox x:Name="MapBox" ItemsSource="{Binding MapNames}" SelectedItem="{Binding MapName}" MinWidth="140" Margin="0,0,6,0"
                          VerticalAlignment="Center" />
                <ComboBox x:Name="FloorBox" MinWidth="110" Margin="0,0,8,0" VerticalAlignment="Center" SelectionChanged="FloorBox_SelectionChanged" />
                <CheckBox Content="{DynamicResource s.map.exfils}" IsChecked="{Binding MapShowExtracts}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <CheckBox Content="{DynamicResource s.map.quests}" IsChecked="{Binding MapShowQuests}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <!-- item search: where the item can lie as loose loot on this map -->
                <Grid VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBox x:Name="SearchBox" Width="170" Padding="20,1,18,1" VerticalContentAlignment="Center"
                             ToolTip="{DynamicResource s.map.search.tip}" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />
                    <TextBlock Text="&#x2315;" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                    <TextBlock x:Name="SearchHint" Text="{DynamicResource s.map.search.hint}" Style="{StaticResource Muted}" FontSize="11"
                               Margin="22,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <Button x:Name="SearchClear" Content="&#x2715;" Style="{StaticResource SmallButton}" FontSize="9" Padding="4,0"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0" Visibility="Collapsed"
                            ToolTip="{DynamicResource s.map.search.clear}" Click="SearchClear_Click" />
                    <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="2" MinWidth="240">
                            <ListBox x:Name="SearchList" MaxHeight="300" Background="Transparent" BorderThickness="0"
                                     MouseLeftButtonUp="SearchList_MouseUp" PreviewKeyDown="SearchList_PreviewKeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock x:Name="Spots" DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="11" Margin="10,0,0,0"
                                                       Text="{Binding Spots, StringFormat={}{0} ◆}" />
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Spots}" Value="0">
                                                <Setter TargetName="Spots" Property="Text" Value="{DynamicResource s.map.search.otherMap}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
                <TextBlock x:Name="SearchCount" Foreground="#FFFF5CC8" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed" />
                <!-- BTR tracker (Woods, Streets, Lighthouse in a raid): route, stops with ETA, estimated spot; which route -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding BtrAvailable, Converter={StaticResource BoolToVis}}">
                    <CheckBox Content="{DynamicResource s.map.btr}" IsChecked="{Binding BtrShowOnMap}" VerticalAlignment="Center" Margin="0,0,4,0"
                              ToolTip="{DynamicResource s.gps.btrMap}" />
                    <ComboBox ItemsSource="{Binding BtrRouteChoices}" SelectedIndex="{Binding BtrRouteIndex}" MinWidth="80" VerticalAlignment="Center"
                              ToolTip="{DynamicResource s.btr.routeTip}" />
                </StackPanel>
            </WrapPanel>
        </DockPanel>

        <DockPanel x:Name="Footer" DockPanel.Dock="Bottom" Margin="8,2,18,6">
            <Slider x:Name="OpacitySlider" DockPanel.Dock="Right" Width="90" Minimum="0.3" Maximum="1" Value="{Binding MapOpacity}" VerticalAlignment="Center"
                    ToolTip="{DynamicResource s.ov.opacity}" Visibility="Collapsed" />
            <TextBlock x:Name="Status" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </DockPanel>

        <Grid x:Name="Viewport" ClipToBounds="True" Background="#FF14171A" Margin="1,0,1,0" Focusable="True" FocusVisualStyle="{x:Null}"
              MouseWheel="Viewport_MouseWheel" MouseLeftButtonDown="Viewport_MouseDown" MouseMove="Viewport_MouseMove"
              MouseLeftButtonUp="Viewport_MouseUp" SizeChanged="Viewport_SizeChanged">
            <Canvas x:Name="Pictures" IsHitTestVisible="False">
                <Canvas.RenderTransform>
                    <MatrixTransform x:Name="View" />
                </Canvas.RenderTransform>
            </Canvas>
            <Canvas x:Name="Markers" />
            <!-- the quest marker clicked last: name and objectives, next to the marker (filled in code) -->
            <Canvas>
                <Border x:Name="QuestCard" Visibility="Collapsed" Width="290" Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="5" Padding="10,6,6,8"
                        MouseLeftButtonDown="QuestCard_MouseDown" Cursor="Arrow">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource SmallButton}" FontSize="10" Padding="5,0"
                                    Margin="6,0,0,0" VerticalAlignment="Top" ToolTip="{DynamicResource s.map.card.close}" Click="CardClose_Click" />
                            <TextBlock x:Name="CardTitle" FontWeight="Bold" FontSize="13" Foreground="#FFFFD54A" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock x:Name="CardMeta" DockPanel.Dock="Top" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,1,4,6" />
                        <TextBlock DockPanel.Dock="Bottom" FontSize="11" Margin="0,6,0,0">
                            <Hyperlink Foreground="{StaticResource AccentBrush}" Click="CardWiki_Click">
                                <Run Text="{DynamicResource s.map.card.wiki}" />
                            </Hyperlink>
                        </TextBlock>
                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                            <StackPanel x:Name="CardBody" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Canvas>
            <TextBlock x:Name="Message" Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" IsHitTestVisible="False" />
        </Grid>
    </DockPanel>
</UserControl>
